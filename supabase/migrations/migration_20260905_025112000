-- H-010: every new feedback report must carry 1–3 screenshots.
-- Trigger BEFORE INSERT only (a CHECK would also re-validate on status UPDATEs of
-- legacy rows that legitimately have 0 shots). The trigger is defense in depth:
-- the submit path already enforces the same rule in frontend and in the
-- submit-feedback backend function.
create or replace function public.feedback_enforce_screenshots()
returns trigger
language plpgsql
as $$
declare
  shots jsonb;
  item text;
begin
  shots := coalesce(new.context -> 'screenshots', '[]'::jsonb);
  if jsonb_typeof(shots) <> 'array' then
    raise exception 'Please attach at least one screenshot to send the report.';
  end if;
  if jsonb_array_length(shots) < 1 then
    raise exception 'Please attach at least one screenshot to send the report.';
  end if;
  if jsonb_array_length(shots) > 3 then
    raise exception 'A maximum of 3 screenshots is allowed per report.';
  end if;
  for item in select jsonb_array_elements_text(shots)
  loop
    if item is null or btrim(item) = '' then
      raise exception 'A screenshot could not be read. Please try attaching it again.';
    end if;
  end loop;
  return new;
end;
$$;

drop trigger if exists feedback_reports_enforce_screenshots on public.feedback_reports;
create trigger feedback_reports_enforce_screenshots
  before insert on public.feedback_reports
  for each row execute function public.feedback_enforce_screenshots();